---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuidePage from '../../components/GuidePage.astro';
import { getGuideUrl, guides, guideSectionMeta } from '../../data/guides';
import { attraction } from '../../data/site';

export function getStaticPaths() {
  return guides.map((page) => ({
    params: { section: page.section, slug: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props;
const sectionMeta = guideSectionMeta[page.section];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: page.h1,
      description: page.description,
      ...(Astro.site ? { url: new URL(getGuideUrl(page), Astro.site).href } : {}),
      about: {
        '@type': 'TouristAttraction',
        name: attraction.name,
        sameAs: [attraction.googleMaps]
      },
      isPartOf: {
        '@type': 'WebSite',
        name: 'Mercado de Artesanias El Parian Puebla'
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        ...(Astro.site ? [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).href }] : []),
        { '@type': 'ListItem', position: 2, name: sectionMeta.label },
        { '@type': 'ListItem', position: 3, name: page.h1 }
      ]
    }
  ]
};
---
<BaseLayout locale="es" title={page.title} description={page.description} schema={schema} alternateLocales={false} showLangSwitch={false}>
  <GuidePage page={page} />
</BaseLayout>
