---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_NAME } from '../data/site';
import { content } from '../data/content';
import type { Locale } from '../data/content';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}
const { locale, title, description, schema, noindex = false } = Astro.props;
const copy = content[locale];
const pagePath = Astro.url.pathname === '/404/' ? '/404' : Astro.url.pathname;
const canonical = Astro.site ? new URL(pagePath, Astro.site).href : undefined;
const origin = Astro.site ? Astro.site.origin : undefined;
const topic = Astro.url.pathname.replace(/^\/en(?=\/)/, '').replace(/^\/404\/$/, '/404');
const esUrl = origin ? `${origin}${topic}` : undefined;
const enUrl = origin ? `${origin}/en${topic}${topic === '/404' ? '/' : ''}` : undefined;
---
<!doctype html>
<html lang={copy.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#164f9c" />
    <meta name="geo.region" content="MX-PUE" />
    <meta name="geo.placename" content="Heroica Puebla de Zaragoza" />
    <meta name="geo.position" content="19.0431794;-98.1932827" />
    <meta name="ICBM" content="19.0431794, -98.1932827" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {esUrl && <link rel="alternate" hreflang="es" href={esUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {esUrl && <link rel="alternate" hreflang="x-default" href={esUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={copy.ogLocale} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_MX'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={Astro.site ? new URL('/images/parian-concept.svg', Astro.site).href : '/images/parian-concept.svg'} />
    <meta property="og:image:alt" content={copy.breadcrumbHome === 'Inicio' ? 'Ilustración conceptual de artesanías; no es fotografía del mercado' : 'Conceptual crafts illustration; not a market photograph'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    {schema && <JsonLd data={schema} />}
    <script is:inline src="/analytics.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">{(locale === 'es' ? 'Saltar al contenido' : 'Skip to content')}</a>
    <Header locale={locale} />
    <main id="contenido"><slot /></main>
    <Footer locale={locale} />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
