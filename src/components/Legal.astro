---
import BaseLayout from '../layouts/BaseLayout.astro';
import { legal } from '../data/legal';
import type { Locale } from '../data/content';
import type { LegalPage } from '../data/legal';

interface Props { locale: Locale; page: LegalPage; }
const { locale, page } = Astro.props;
const data = legal[locale];
const isCookies = page === 'cookies';
const cookies = data.cookies;
const other = (data as any)[page];

const switchHtml = (card: any) => {
  if (card.state === 'locked-on') return `<label class="switch"><input type="checkbox" checked disabled /><span></span><strong>${card.label}</strong></label>`;
  if (card.state === 'analytics') return `<label class="switch"><input id="analytics" type="checkbox" /><span></span><strong>${card.label}</strong></label>`;
  if (card.state === 'prefs') return `<label class="switch"><input id="preferences" type="checkbox" disabled /><span></span><strong>${card.label}</strong></label>`;
  return `<label class="switch"><input type="checkbox" disabled /><span></span><strong>${card.label}</strong></label>`;
};
---
<BaseLayout locale={locale} title={other.title} description={other.description}>
  <article class="legal wrap cookie-page">
    <p class="eyebrow">{other.eyebrow}</p>
    <h1>{other.h1}</h1>
    <p class="updated">{other.updated}</p>

    {isCookies && (
      <>
        <p>{cookies.intro}</p>
        {cookies.cards.map((card) => (
          <div class="cookie-card">
            <div><h2>{card.title}</h2><p>{card.text}</p></div>
            <Fragment set:html={switchHtml(card)} />
          </div>
        ))}
        <div class="cookie-actions">
          <button class="button" id="savePrefs" type="button">{cookies.save}</button>
          <button class="button button-ghost" id="rejectPrefs" type="button">{cookies.reject}</button>
        </div>
        <p id="cookieStatus" class="cookie-status" role="status" aria-live="polite"></p>
        <h2>{cookies.consentTitle}</h2>
        <p set:html={cookies.consentText} />
      </>
    )}

    {!isCookies && (
      <>
        {other.blocks.map((b: any) => (<><h2>{b.h2}</h2><p set:html={b.html} /></>))}
        {other.footerLink && <p><a class="text-link" href={other.footerLink.href}>{other.footerLink.text}</a></p>}
      </>
    )}
  </article>

  {isCookies && (
    <script is:inline>
      (() => {
        const api=window.elparianAnalytics,box=document.getElementById('analytics'),status=document.getElementById('cookieStatus');
        if(!api||!box||!status)return;
        const en=document.documentElement.lang==='en';box.checked=api.effective;
        const save=allow=>{const result=api.save({analytics:allow});box.checked=result.effective;status.textContent=result.saved?(en?(result.effective?'Saved. Analytics is active on this page.':'Saved. Analytics is off.'):(result.effective?'Guardado. La analítica está activa en esta página.':'Guardado. La analítica está desactivada.')):(en?'Saving could not be confirmed. Analytics is off on this page; a prior permission may remain stored for other visits.':'No se pudo confirmar el guardado. La analítica está desactivada en esta página; un permiso anterior puede seguir guardado para otras visitas.');};
        document.getElementById('savePrefs')?.addEventListener('click',()=>save(box.checked));
        document.getElementById('rejectPrefs')?.addEventListener('click',()=>save(false));
        window.addEventListener('elparian-analytics-change',()=>{box.checked=api.effective;status.textContent='';});
      })();
    </script>
  )}
</BaseLayout>
