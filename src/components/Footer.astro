---
import Logo from './Logo.astro';
import { authorityLinks } from '../data/site';
import { content } from '../data/content';
import type { Locale } from '../data/content';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = content[locale].ui;
const prefix = locale === 'es' ? '' : '/en';
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <Logo locale={locale} />
      <p class="footer-lead">{ui.footerLead}</p>
    </div>
    <div>
      <h2>{ui.footerInfo}</h2>
      <a href={`${prefix}/privacidad/`}>{ui.footerPrivacy}</a>
      <a href={`${prefix}/terminos/`}>{ui.footerTerms}</a>
      <a href={`${prefix}/cookies/`}>{ui.footerCookies}</a>
    </div>
    <div>
      <h2>{ui.footerSources}</h2>
      {authorityLinks.map((item) => <a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a>)}
    </div>
  </div>
  <div class="wrap footer-notes">
    {ui.footerNotes.map((p) => <p>{p}</p>)}
  </div>
</footer>
